#!/usr/bin/env bash
# Rejects a commit that leaves any comment block it touches longer than three
# lines (CLAUDE.md). Enable once per clone: git config core.hooksPath .githooks
# Given a base ref, as CI does, it checks what the branch adds since that ref.
max=3
status=0
if [ -n "${1:-}" ]; then
  # A base git cannot diff against would leave no files and pass unchecked.
  git merge-base "$1" HEAD >/dev/null 2>&1 || { echo "pre-commit: cannot compare against base $1" >&2; exit 2; }
  diff=(git diff "$1...HEAD")
  src=HEAD:
else
  diff=(git diff --cached)
  src=:
fi

# check <path> [old path]: a rename is diffed against its old path, so only the
# lines it really adds count.
check() {
  local f=$1 added out
  added=$("${diff[@]}" -U0 -M -- "$@" | awk '/^@@/ {
    split($3, a, ","); n = substr(a[1], 2); c = (a[2] == "" ? 1 : a[2])
    for (i = 0; i < c; i++) printf "%d ", n + i }')
  [ -z "$added" ] && return
  # The whole block around an added line counts, so growing an old one is caught.
  out=$(git show "$src$f" | awk -v max="$max" -v added="$added" -v file="$f" '
    BEGIN { n = split(added, l, " "); for (i = 1; i <= n; i++) want[l[i]] = 1 }
    function count() { if (len == 0) start = NR; len++; if (NR in want) hit = 1 }
    function flush() {
      if (len > max && hit) printf "%s:%d: comment block is %d lines, keep it to %d\n", file, start, len, max
      len = 0; hit = 0
    }
    function ticks(   line) { line = $0; return gsub(/`/, "", line) }
    inblock { count(); if (index($0, closer)) inblock = 0; next }
    # Lines inside a backtick string (Go raw, JS template) are data, not comments.
    inraw { flush(); if (ticks() % 2) inraw = 0; next }
    /^[[:space:]]*\/\/(go:|\+build|nolint)/ { flush(); next }
    /^[[:space:]]*\/\// { count(); next }
    /^[[:space:]]*(\/\*|<!--)/ {
      count()
      closer = ($0 ~ /^[[:space:]]*\/\*/) ? "*/" : "-->"
      rest = $0; sub(/^[[:space:]]*(\/\*|<!--)/, "", rest)
      if (!index(rest, closer)) inblock = 1
      next
    }
    { flush(); if (ticks() % 2) inraw = 1 }
    END { flush() }')
  if [ -n "$out" ]; then
    echo "$out"
    status=1
  fi
}

while IFS= read -r -d '' st; do
  old=
  case $st in R*) IFS= read -r -d '' old ;; esac
  IFS= read -r -d '' f
  case $f in *.go | *.ts | *.js | *.svelte) ;; *) continue ;; esac
  if [ -n "$old" ]; then check "$f" "$old"; else check "$f"; fi
done < <("${diff[@]}" --name-status -z -M --diff-filter=AMR)

[ $status -eq 0 ] || echo "Shorten them, or commit with --no-verify if a block truly needs the room."
exit $status
